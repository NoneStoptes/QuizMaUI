<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Quiz.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Quiz.ViewModels"
    Title="HomePage"
    BackgroundColor="#181818">

    <ContentPage.BindingContext>
        <vm:HomePageViewModel />
    </ContentPage.BindingContext>

    <Grid Padding="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header Row with Welcome and Exit  -->
        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto"
            HeightRequest="48"
            VerticalOptions="Start">

            <Label
                Margin="8,0,0,0"
                FontAttributes="Bold"
                FontSize="20"
                HorizontalOptions="Start"
                Text="{Binding Greeting}"
                TextColor="#E0E0E0"
                VerticalOptions="Center" />

            <Frame
                Grid.Column="1"
                Margin="0,4,8,4"
                Padding="0"
                BackgroundColor="#2D2D2D"
                CornerRadius="4"
                HeightRequest="40"
                HorizontalOptions="End"
                VerticalOptions="Center"
                WidthRequest="100">

                <Grid Padding="8,0" ColumnDefinitions="Auto,*">
                    <Image
                        HeightRequest="20"
                        HorizontalOptions="Start"
                        Source="https://img.icons8.com/ios-filled/50/fa314a/exit.png"
                        VerticalOptions="Center"
                        WidthRequest="20" />

                    <Label
                        Grid.Column="1"
                        FontAttributes="Bold"
                        FontSize="16"
                        HorizontalOptions="Center"
                        Text="Exit"
                        TextColor="#FA314A"
                        VerticalOptions="Center" />
                </Grid>

                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLogoutClicked" />
                </Frame.GestureRecognizers>
            </Frame>
        </Grid>

        <!--  Redesigned Search Bar  -->
        <Grid
            Grid.Row="1"
            Margin="0,16,0,0"
            HorizontalOptions="Center">

            <!--  Single container approach for better control  -->
            <Grid
                Padding="4"
                BackgroundColor="#2D2D2D"
                HeightRequest="48"
                WidthRequest="448">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Search input background  -->
                <BoxView
                    Grid.Column="0"
                    Margin="0,0,4,0"
                    BackgroundColor="#3A3A3A"
                    CornerRadius="8" />

                <!--  Entry with simple positioning  -->
                <Entry
                    x:Name="SearchEntry"
                    Grid.Column="0"
                    Margin="12,0,12,0"
                    BackgroundColor="Transparent"
                    FontSize="16"
                    HorizontalOptions="FillAndExpand"
                    Placeholder="Enter quiz theme..."
                    PlaceholderColor="#9E9E9E"
                    TextColor="#FFFFFF"
                    VerticalOptions="FillAndExpand" />

                <!--  Enhanced Search Button  -->
                <Grid
                    Grid.Column="1"
                    Margin="2,0,0,0"
                    HeightRequest="40"
                    WidthRequest="52">

                    <!--  Shadow effect layer  -->
                    <BoxView
                        BackgroundColor="#000000"
                        CornerRadius="10"
                        Opacity="0.3"
                        TranslationX="2"
                        TranslationY="2" />

                    <!--  Gradient background simulation  -->
                    <BoxView BackgroundColor="#FF5252" CornerRadius="10" />

                    <!--  Main button background  -->
                    <Frame
                        Margin="0"
                        Padding="0"
                        BackgroundColor="#FF6B6B"
                        BorderColor="#FF8A80"
                        CornerRadius="10"
                        HasShadow="False">

                        <Grid>
                            <!--  Subtle top highlight  -->
                            <BoxView
                                Margin="10,0"
                                BackgroundColor="#FFFFFF"
                                HeightRequest="1"
                                Opacity="0.3"
                                VerticalOptions="Start" />

                            <!--  Icon container with better positioning  -->
                            <Frame
                                Padding="0"
                                BackgroundColor="Transparent"
                                BorderColor="Transparent"
                                HasShadow="False"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">

                                <Image
                                    HeightRequest="22"
                                    Opacity="0.95"
                                    Source="https://img.icons8.com/ios-filled/50/ffffff/search.png"
                                    WidthRequest="22">
                                    <!--  Add a subtle glow effect to the icon  -->
                                    <Image.Shadow>
                                        <Shadow
                                            Brush="White"
                                            Opacity="0.5"
                                            Radius="8"
                                            Offset="0,0" />
                                    </Image.Shadow>
                                </Image>
                            </Frame>

                            <!--  Hover/pressed effect overlay  -->
                            <BoxView
                                x:Name="SearchButtonOverlay"
                                BackgroundColor="#FFFFFF"
                                InputTransparent="True"
                                Opacity="0" />
                        </Grid>
                    </Frame>

                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSearchClicked" />
                    </Grid.GestureRecognizers>
                </Grid>

                <!--  Outer rounded corners  -->
                <Grid.Clip>
                    <RoundRectangleGeometry CornerRadius="12" Rect="0,0,448,48" />
                </Grid.Clip>
            </Grid>
        </Grid>

        <!--  Difficulty Level Selection  -->
        <HorizontalStackLayout
            Grid.Row="2"
            Margin="0,24,0,0"
            HorizontalOptions="Center"
            Spacing="24"
            VerticalOptions="Start">

            <VerticalStackLayout HorizontalOptions="Center" Spacing="0">
                <RadioButton
                    x:Name="VeryEasyRadio"
                    GroupName="DifficultyGroup"
                    HorizontalOptions="Center"
                    IsChecked="True"
                    VerticalOptions="Center"
                    Value="VeryEasy" />
                <Label
                    Margin="0,-8,0,0"
                    FontSize="14"
                    HorizontalOptions="Center"
                    Text="Very Easy"
                    TextColor="#E0E0E0" />
            </VerticalStackLayout>

            <VerticalStackLayout HorizontalOptions="Center" Spacing="0">
                <RadioButton
                    x:Name="EasyRadio"
                    GroupName="DifficultyGroup"
                    HorizontalOptions="Center"
                    IsChecked="False"
                    VerticalOptions="Center"
                    Value="Easy" />
                <Label
                    Margin="0,-8,0,0"
                    FontSize="14"
                    HorizontalOptions="Center"
                    Text="Easy"
                    TextColor="#E0E0E0" />
            </VerticalStackLayout>

            <VerticalStackLayout HorizontalOptions="Center" Spacing="0">
                <RadioButton
                    x:Name="MediumRadio"
                    GroupName="DifficultyGroup"
                    HorizontalOptions="Center"
                    IsChecked="False"
                    VerticalOptions="Center"
                    Value="Medium" />
                <Label
                    Margin="0,-8,0,0"
                    FontSize="14"
                    HorizontalOptions="Center"
                    Text="Medium"
                    TextColor="#E0E0E0" />
            </VerticalStackLayout>

            <VerticalStackLayout HorizontalOptions="Center" Spacing="0">
                <RadioButton
                    x:Name="HardRadio"
                    GroupName="DifficultyGroup"
                    HorizontalOptions="Center"
                    IsChecked="False"
                    VerticalOptions="Center"
                    Value="Hard" />
                <Label
                    Margin="0,-8,0,0"
                    FontSize="14"
                    HorizontalOptions="Center"
                    Text="Hard"
                    TextColor="#E0E0E0" />
            </VerticalStackLayout>
        </HorizontalStackLayout>
    </Grid>
</ContentPage>