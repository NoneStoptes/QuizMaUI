<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Quiz.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:conv="clr-namespace:Quiz.Converters"
    xmlns:vm="clr-namespace:Quiz.ViewModels">

    <!--  Resources  -->
    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:BoolenToBluRed x:Key="BoolenToBluRed" />
            <conv:RadioButtonConverter x:Key="RadioButtonConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.BindingContext>
        <vm:HomePageViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Content>
        <Grid
            Padding="10"
            ColumnDefinitions="*, *, *, *"
            ColumnSpacing="5"
            RowDefinitions="Auto, Auto, Auto, Auto, Auto, *"
            RowSpacing="10">

            <!--  Заголовок  -->
            <StackLayout
                Grid.Row="0"
                Grid.ColumnSpan="4"
                HorizontalOptions="Fill"
                Orientation="Horizontal"
                VerticalOptions="Start">
                <Label
                    FontAttributes="Bold"
                    FontSize="24"
                    HorizontalOptions="StartAndExpand"
                    Text="Quiz" />
            </StackLayout>

            <Button
                Padding="0"
                AbsoluteLayout.LayoutBounds="1,0,AutoSize,AutoSize"
                AbsoluteLayout.LayoutFlags="PositionProportional"
                BackgroundColor="LightGray"
                Clicked="OnLogoutClicked"
                CornerRadius="5"
                FontSize="14"
                HeightRequest="30"
                Text="⎋"
                WidthRequest="30" />




            <!--  Приветствие  -->
            <Label
                Grid.Row="1"
                Grid.ColumnSpan="4"
                FontAttributes="Bold"
                FontSize="20"
                HorizontalOptions="Start"
                Text="Welcome, User!"
                VerticalOptions="Center" />

            <!--  Поисковая строка  -->
            <Frame
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Padding="5"
                BackgroundColor="#333333"
                BorderColor="DarkGray"
                CornerRadius="10"
                VerticalOptions="Center">
                <StackLayout Orientation="Horizontal">
                    <Image
                        HeightRequest="20"
                        Source="search_icon.png"
                        VerticalOptions="Center"
                        WidthRequest="20" />
                    <Entry
                        BackgroundColor="Transparent"
                        HorizontalOptions="FillAndExpand"
                        Placeholder="Theme of Quiz"
                        PlaceholderColor="Gray"
                        TextColor="White" />
                </StackLayout>
            </Frame>

            <!--  Радио-кнопки  -->
            <RadioButton
                Grid.Row="3"
                Grid.Column="0"
                Content="Very Easy"
                GroupName="Difficulty"
                HorizontalOptions="Center"
                IsChecked="{Binding SelectedLevel, Converter={StaticResource RadioButtonConverter}, ConverterParameter=Very Easy}"
                VerticalOptions="Center"
                Value="Very Easy" />
            <RadioButton
                Grid.Row="3"
                Grid.Column="1"
                Content="Easy"
                GroupName="Difficulty"
                HorizontalOptions="Center"
                IsChecked="{Binding SelectedLevel, Converter={StaticResource RadioButtonConverter}, ConverterParameter=Easy}"
                VerticalOptions="Center"
                Value="Easy" />
            <RadioButton
                Grid.Row="3"
                Grid.Column="2"
                Content="Medium"
                GroupName="Difficulty"
                HorizontalOptions="Center"
                IsChecked="{Binding SelectedLevel, Converter={StaticResource RadioButtonConverter}, ConverterParameter=Medium}"
                VerticalOptions="Center"
                Value="Medium" />
            <RadioButton
                Grid.Row="3"
                Grid.Column="3"
                Content="Hard"
                GroupName="Difficulty"
                HorizontalOptions="Center"
                IsChecked="{Binding SelectedLevel, Converter={StaticResource RadioButtonConverter}, ConverterParameter=Hard}"
                VerticalOptions="Center"
                Value="Hard" />

            <!--  Карточки  -->
            <CollectionView
                Grid.Row="4"
                Grid.ColumnSpan="4"
                IsVisible="{Binding AreCardsVisible}"
                ItemsSource="{Binding Cards}">
                <CollectionView.ItemsLayout>
                    <!--  Вертикальный список  -->
                    <LinearItemsLayout ItemSpacing="10" Orientation="Vertical" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame
                            Padding="10"
                            BackgroundColor="#444444"
                            BorderColor="Gray"
                            CornerRadius="10"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="Center">
                            <StackLayout
                                HorizontalOptions="Center"
                                Orientation="Horizontal"
                                Spacing="5"
                                VerticalOptions="Center">
                                <Image
                                    HeightRequest="50"
                                    Source="{Binding Image}"
                                    WidthRequest="50" />
                                <Label
                                    FontSize="18"
                                    Text="{Binding Title}"
                                    TextColor="White"
                                    VerticalOptions="Center" />
                            </StackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>




        </Grid>
    </ContentPage.Content>
</ContentPage>