<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Quiz.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Quiz.ViewModels"
    Title="HomePage"
    BackgroundColor="#181818">

    <ContentPage.BindingContext>
        <vm:HomePageViewModel />
    </ContentPage.BindingContext>

    <Grid Padding="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto"
            HeightRequest="48"
            VerticalOptions="Start">

            <Label
                Margin="8,0,0,0"
                FontAttributes="Bold"
                FontSize="20"
                HorizontalOptions="Start"
                Text="{Binding Greeting}"
                TextColor="#E0E0E0"
                VerticalOptions="Center" />

            <Frame
                Grid.Column="1"
                Margin="0,4,8,4"
                Padding="0"
                BackgroundColor="#2D2D2D"
                CornerRadius="4"
                HeightRequest="40"
                HorizontalOptions="End"
                VerticalOptions="Center"
                WidthRequest="100">

                <Grid Padding="8,0" ColumnDefinitions="Auto,*">
                    <Image
                        HeightRequest="20"
                        HorizontalOptions="Start"
                        Source="https://img.icons8.com/ios-filled/50/fa314a/exit.png"
                        VerticalOptions="Center"
                        WidthRequest="20" />

                    <Label
                        Grid.Column="1"
                        FontAttributes="Bold"
                        FontSize="16"
                        HorizontalOptions="Center"
                        Text="Exit"
                        TextColor="#FA314A"
                        VerticalOptions="Center" />
                </Grid>

                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLogoutClicked" />
                </Frame.GestureRecognizers>
            </Frame>
        </Grid>

        <!--  Строка 1: Поисковая строка  -->
        <Frame
            Grid.Row="1"
            Margin="0,16,0,0"
            Padding="0"
            BackgroundColor="#2D2D2D"
            CornerRadius="12"
            HeightRequest="40"
            HorizontalOptions="Center"
            VerticalOptions="Start"
            WidthRequest="448">
            <Grid BackgroundColor="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="56" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Margin="0,4,8,4"
                    BackgroundColor="#3A3A3A"
                    Stroke="#4A4A4A"
                    StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <Entry
                        Margin="12,0"
                        BackgroundColor="Transparent"
                        FontSize="16"
                        Placeholder="Enter quiz theme..."
                        PlaceholderColor="#9E9E9E"
                        TextColor="#FFFFFF"
                        VerticalOptions="Center" />
                </Border>

                <!--  Обновленная кнопка поиска  -->
                <Border
                    Grid.Column="1"
                    Margin="4,4,4,4"
                    BackgroundColor="#FF6B6B"
                    HeightRequest="32"
                    HorizontalOptions="Center"
                    StrokeThickness="0"
                    VerticalOptions="Center"
                    WidthRequest="48">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>

                    <!--  Иконка поиска  -->
                    <Image
                        Aspect="AspectFit"
                        HeightRequest="18"
                        HorizontalOptions="Center"
                        Source="https://img.icons8.com/ios-filled/50/ffffff/search.png"
                        VerticalOptions="Center"
                        WidthRequest="18" />

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSearchClicked" />
                    </Border.GestureRecognizers>
                </Border>
            </Grid>
        </Frame>

        <HorizontalStackLayout
            Grid.Row="2"
            Margin="0,24,0,0"
            HorizontalOptions="Center"
            Spacing="24"
            VerticalOptions="Start">

            <VerticalStackLayout HorizontalOptions="Center" Spacing="0">
                <RadioButton
                    HorizontalOptions="Center"
                    IsChecked="False"
                    VerticalOptions="Center" />
                <Label
                    Margin="0,-8,0,0"
                    FontSize="14"
                    HorizontalOptions="Center"
                    Text="Very Easy"
                    TextColor="#E0E0E0" />
            </VerticalStackLayout>

            <VerticalStackLayout HorizontalOptions="Center" Spacing="0">
                <RadioButton
                    HorizontalOptions="Center"
                    IsChecked="False"
                    VerticalOptions="Center" />
                <Label
                    Margin="0,-8,0,0"
                    FontSize="14"
                    HorizontalOptions="Center"
                    Text="Easy"
                    TextColor="#E0E0E0" />
            </VerticalStackLayout>

            <VerticalStackLayout HorizontalOptions="Center" Spacing="0">
                <RadioButton
                    HorizontalOptions="Center"
                    IsChecked="False"
                    VerticalOptions="Center" />
                <Label
                    Margin="0,-8,0,0"
                    FontSize="14"
                    HorizontalOptions="Center"
                    Text="Medium"
                    TextColor="#E0E0E0" />
            </VerticalStackLayout>

            <VerticalStackLayout HorizontalOptions="Center" Spacing="0">
                <RadioButton
                    HorizontalOptions="Center"
                    IsChecked="False"
                    VerticalOptions="Center" />
                <Label
                    Margin="0,-8,0,0"
                    FontSize="14"
                    HorizontalOptions="Center"
                    Text="Hard"
                    TextColor="#E0E0E0" />
            </VerticalStackLayout>
        </HorizontalStackLayout>
    </Grid>
</ContentPage>